# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/rzilient?schema=public"

# Secret used to sign session cookies (openssl rand -base64 48).
AUTH_SECRET=""

# Public origin of the application.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Operational timezone for display formatting.
APP_TIMEZONE="Africa/Freetown"
